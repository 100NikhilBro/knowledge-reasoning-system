NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# Redis (working-memory + ingestion worker)
REDIS_URL=redis://localhost:6379

# Embeddings (@knowledge/embeddings)
#
# Providers:
#   deterministic       — local hash vectors for tests / zero-key fallback (NOT semantic)
#   openai-compatible   — production semantic embeddings (OpenAI or compatible /v1/embeddings)
#
# Production semantic (recommended):
#   EMBEDDING_PROVIDER=openai-compatible
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536
#   EMBEDDING_API_KEY=sk-...
#   EMBEDDING_BASE_URL=https://api.openai.com/v1
#   QDRANT_VECTOR_SIZE=1536   # MUST match EMBEDDING_DIMENSIONS
#
# Migration from deterministic 32-d vectors:
#   1. Set the semantic vars above (dimensions must be explicit — no silent inventing).
#   2. node scripts/recreate-qdrant-collection.mjs
#   3. Clear processed markers and re-run worker produce + ingest so EntityIndexer
#      regenerates vectors. Do NOT mix old deterministic points with semantic ones.
#
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=deterministic-hash-v1
EMBEDDING_DIMENSIONS=32
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_BATCH_SIZE=64

# Vector store / Qdrant (@knowledge/vector-store)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_entities
# MUST equal EMBEDDING_DIMENSIONS (falls back to EMBEDDING_DIMENSIONS when unset)
QDRANT_VECTOR_SIZE=32
QDRANT_DISTANCE=Cosine
# QDRANT_API_KEY=
# QDRANT_TIMEOUT_MS=30000

# Entity indexing (@knowledge/vector-store EntityIndexer)
# Falls back to EMBEDDING_MAX_BATCH_SIZE when unset
INDEXING_BATCH_SIZE=64
INDEXING_ENSURE_COLLECTION=true

# Ingestion worker (@knowledge/worker)
INGESTION_QUEUE_NAME=knowledge-ingestion
INGESTION_CONCURRENCY=1
INGESTION_INITIALIZE_GRAPH_SCHEMA=true

# Multi-document discovery / processed marking
# Relative to the monorepo root (not apps/worker cwd)
KNOWLEDGE_RAW_DIR=knowledge_state/raw
KNOWLEDGE_PROCESSED_DIR=knowledge_state/processed
# Comma-separated extensions (current parser expects PEP-style .md)
INGESTION_SUPPORTED_EXTENSIONS=.md

# Reasoning context budget (@knowledge/reasoning)
# Highest-ranked evidence is retained when truncated
REASONING_CONTEXT_MAX_EVIDENCE=20

# LLM / inference (@knowledge/reasoning) — Groq
# LLM_PROVIDER=groq|template  (default: groq)
# GROQ_API_KEY is required when LLM_PROVIDER=groq. Never commit real keys.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000

# API security (@knowledge/api)
# Required for POST /reason. Do not commit real secrets.
API_KEY=change-me-in-development
# In-memory rate limit for authenticated /reason (not distributed)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# Web UI (@knowledge/web) — set in apps/web/.env.local for local Vite
# VITE_API_BASE_URL=/api
# VITE_API_KEY=change-me-in-development
